.venv/
__pycache__/
*.pyc
.env
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/
proxy-ca/
# Runtime state of the persistent request log -- the SQLite database and its
# WAL sidecar files, machine-local, not published (ROUTER_STORAGE_DB_PATH)
state/
# Personal working routing config with production providers and internal
# hosts -- not published. The repository example is routing.example.yaml,
# see ROUTER_CONFIG_PATH in .env
routing.yaml
routing.yaml.bak-*
# Local CA bundles for upstream providers -- personal, not published; the
# certs/ directory itself is tracked via certs/.gitkeep
certs/*.pem
# Site-local notes for .claude/skills/* (internal gateway hosts, key
# procedures, model ids) -- personal, not published; the committed template
# is references/local.example.md next to each skill
.claude/skills/*/references/local/
# Internal agent-workflow journal -- not published
tasks/
# macOS Finder metadata
.DS_Store
# Local launchd label for scripts/restart_router.sh -- one machine's service name
.launchd-label
.pytest_state/
