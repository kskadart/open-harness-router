# Required: path to the routing registry.
# routing.yaml is created by copying routing.example.yaml (see README) and
# is personal, like .env -- not committed to git.
ROUTER_CONFIG_PATH=./routing.yaml

# Server (optional, defaults shown)
ROUTER_SERVER_HOST=127.0.0.1
ROUTER_SERVER_PORT=8787

# Logging (optional)
ROUTER_LOG_LEVEL=INFO

# Provider secrets (variable names are set in routing.yaml -> api_key_env)
OPENAI_COMPATIBLE_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# VLLM_API_KEY=

# Forward proxy (HTTPS_PROXY mode; started via make run-proxy)
ROUTER_PROXY_HOST=127.0.0.1
ROUTER_PROXY_PORT=8788
# Comma-separated hosts for which TLS is terminated and the request goes to
# the provider registry; every other host is a blind tunnel, no decryption
ROUTER_PROXY_MITM_HOSTS=api.anthropic.com
ROUTER_PROXY_CA_DIR=./proxy-ca
ROUTER_PROXY_CONNECT_TIMEOUT_S=10.0
# TLS handshake -- both with the client (MITM termination) and with the
# real upstream
ROUTER_PROXY_TLS_HANDSHAKE_TIMEOUT_S=10.0
# Reading the request from the client (CONNECT, headers, body); also the
# idle limit for keep-alive between requests on the same connection
ROUTER_PROXY_CLIENT_REQUEST_TIMEOUT_S=30.0
# Waiting for upstream status and response headers, separate from the body
ROUTER_PROXY_UPSTREAM_HEADERS_TIMEOUT_S=30.0
# Silence between chunks of an already-started transfer (response body,
# blind tunnel) -- a long legitimate stream isn't interrupted as long as
# bytes keep flowing
ROUTER_PROXY_IDLE_TIMEOUT_S=60.0
# Corporate proxy through which the router itself exits outward (empty --
# direct connections). Credentials in the URL are allowed:
# http://user:secret@proxy:3128
# ROUTER_PROXY_UPSTREAM_PROXY_URL=http://proxy.corp.internal:3128
# CA bundle for verifying certificates on the outbound side (TLS inspection)
# ROUTER_PROXY_UPSTREAM_CA_BUNDLE=./certs/corporate_bundle.pem
# Comma-separated hosts that always go direct, bypassing the corporate proxy
# ROUTER_PROXY_NO_PROXY_HOSTS=localhost,127.0.0.1
# Retry establishing the outbound TCP/TLS connection (before the first byte
# of the request to upstream and before the first byte of the response to
# the client); exponential backoff
ROUTER_PROXY_RETRY_MAX_ATTEMPTS=3
ROUTER_PROXY_RETRY_BACKOFF_BASE_S=0.25
ROUTER_PROXY_RETRY_BACKOFF_MAX_S=2.0

# Outbound connections to all upstreams (shared across providers)
# force_ipv4: bind outbound sockets to IPv4. Needed where there is no IPv6
# connectivity but a default IPv6 route is still advertised -- e.g. left
# behind by an inactive VPN tunnel. On such a network a connection attempt
# doesn't fail immediately, it hangs until the connect timeout: upstreams
# publish AAAA records, and the resolver regularly returns the IPv6 address
# first.
ROUTER_UPSTREAM_FORCE_IPV4=true
ROUTER_UPSTREAM_MAX_CONNECTIONS=100
ROUTER_UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=20
# Idle period after which a connection is closed. After a network glitch a
# connection can remain half-dead (TCP considers it alive, but no traffic
# flows), and reusing such a connection gives a timeout instead of a
# response.
ROUTER_UPSTREAM_KEEPALIVE_EXPIRY_S=30.0
