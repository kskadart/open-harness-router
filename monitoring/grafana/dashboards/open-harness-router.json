      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ohr-prometheus"
          },
          "expr": "ohr_requests_total",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ohr-prometheus"
          },
          "expr": "ohr_errors_total",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
