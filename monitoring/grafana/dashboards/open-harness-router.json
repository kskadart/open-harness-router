      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "Value #A": "requests",
              "Value #B": "errors",
              "Value #C": "tokens",
              "Value #D": "cost usd"
            }
          }
        }
